# Iris HTTP address (LXC 120). The event stream uses the same host.
IRIS_URL=10.10.20.50:3000
# Bearer token for the Iris API (same one KakaoBot uses).
IRIS_TOKEN=
# Cursor name on the Iris event stream. Iris keeps one cursor per name, so KakaoBot is unaffected.
IRIS_CLIENT_ID=kakao-agent

# live = really send KakaoTalk messages. dry = log what would be sent (default outside production).
SEND_MODE=live
# Chat ids the bot may send to, comma separated. Empty = every registered room.
# Keep this at the test room while the agent is being built.
SEND_ROOMS=284735378053547

# Kakao Login (developers.kakao.com → app → REST API key and client secret). Register the redirect URI
# ${PUBLIC_URL}/api/auth/kakao/callback. On first start the log prints a one-time ${PUBLIC_URL}/setup/...
# link; whoever opens it and signs in with Kakao becomes the owner.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
PUBLIC_URL=https://bot.xenv.cc

# The agent: an OpenAI-compatible endpoint (freellmapi's unified key, from its 열쇠 → 통합 API 키 tab),
# the model ("auto" lets freellmapi route) and the command that calls it in KakaoTalk.
LLM_BASE_URL=http://10.10.20.100:3001/v1
LLM_API_KEY=
LLM_MODEL=auto
# Tried when LLM_MODEL is slow, out of quota or failing.
LLM_FALLBACK_MODEL=auto
AGENT_COMMAND=/bot

# Where SQLite lives. Mount a volume here in production.
DATA_DIR=/app/data
PORT=8080
